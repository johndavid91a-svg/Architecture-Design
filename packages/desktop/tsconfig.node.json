{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": [
      "node",
      "electron-vite/node"
    ],
    "paths": {
      "@adp/core": [
        "../core/src/index.ts"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "../core/src/**/*.ts"
  ],
  "exclude": [
    "../core/src/**/*.test.ts"
  ]
}
