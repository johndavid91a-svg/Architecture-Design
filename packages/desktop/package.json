{
  "name": "@adp/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron desktop application shell and renderer.",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit",
    "icons": "electron ../../tools/make-icons.cjs",
    "dist": "electron-vite build && electron-builder",
    "dist:dir": "electron-vite build && electron-builder --dir"
  },
  "build": {
    "appId": "pk.architecturedesign.app",
    "productName": "Architecture Design",
    "copyright": "Architecture Design",
    "directories": {
      "buildResources": "build",
      "output": "release"
    },
    "files": [
      "out/**/*",
      "build/icons/**/*",
      "package.json",
      "build/icon.ico"
    ],
    "asarUnpack": [
      "**/node_modules/web-ifc/*.wasm",
      "**/node_modules/pdfjs-dist/**/*.wasm"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "icon": "build/icons",
      "category": "Graphics",
      "synopsis": "Architectural digital twin, design and construction estimation",
      "desktop": {
        "entry": {
          "Name": "Architecture Design",
          "Comment": "Digital twin, design and construction estimation",
          "Categories": "Graphics;Engineering;Science;"
        }
      },
      "executableName": "architecture-design"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Architecture Design"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    }
  },
  "dependencies": {
    "@adp/core": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@types/three": "^0.171.0",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "33.4.11",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.171.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "author": "Architecture Design",
  "repository": {
    "type": "git",
    "url": "https://github.com/johndavid91a-svg/Architecture-Design"
  }
}
